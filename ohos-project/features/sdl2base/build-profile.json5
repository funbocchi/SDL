{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "../../../CMakeLists.txt",
      "arguments": "",
      "cppFlags": ""
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "phone",
      "config": {
        "deviceType": [
          "phone"
        ],
        "buildOption": {
          "externalNativeOptions": {
            "cppFlags": "-DOHPHONE=1",
            "arguments": "-DDEVICE_TYPE=phone"
          }
        }
      }
    },
    {
      "name": "tablet",
      "config": {
        "deviceType": [
          "tablet"
        ],
        "buildOption": {
          "externalNativeOptions": {
            "cppFlags": "-DOHTABLET=1",
            "arguments": "-DDEVICE_TYPE=tablet"
          }
        }
      }
    },
    {
      "name": "laptop",
      "config": {
        "deviceType": [
          "2in1"
        ],
        "buildOption": {
          "externalNativeOptions": {
            "cppFlags": "-DOH2IN1=1",
            "arguments": "-DDEVICE_TYPE=2in1"
          }
        }
      }
    }
  ]
}